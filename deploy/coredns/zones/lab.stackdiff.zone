$ORIGIN lab.stackdiff.
$TTL 60
@       IN SOA ns.lab.stackdiff. hostmaster.lab.stackdiff. (
            2026071801 ; serial
            60         ; refresh
            30         ; retry
            3600       ; expire
            30         ; minimum
            )
@       IN NS  ns.lab.stackdiff.
; Publish MITM as the zone NS address so iterator queries stay on-path
; (auth remains 172.30.0.10 upstream-only; see compose MITM --upstream).
ns      IN A   172.30.0.11
agree   IN A   203.0.113.10
www     IN A   203.0.113.20
check   IN A   203.0.113.99
